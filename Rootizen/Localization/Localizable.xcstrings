    },
    "No previous purchase for Rootizen Plus was found for this Apple ID. Upgrade to get full access." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró ninguna compra anterior de Rootizen Plus para este ID de Apple. Actualiza para obtener acceso completo."
          }
        }
      }
    },
    "No Rootizen Plus to restore" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay Rootizen Plus para restaurar"
          }
        }
      }
    },
    "No. Rootizen is an independent study app. It is not affiliated with, endorsed by, or sponsored by USCIS or any government agency. Always confirm the latest requirements at uscis.gov." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Rootizen es una aplicación de estudio independiente. No está afiliada, respaldada ni patrocinada por el USCIS ni por ninguna agencia gubernamental. Consulta siempre los requisitos más recientes en uscis.gov."
          }
        }
      }
    },
